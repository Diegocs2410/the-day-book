# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env.local
.env*.local

# test artifacts
/test-results/
/playwright-report/
/coverage/

# local secrets (db password, linked project state)
*.local
.supabase/

.vercel
.env*

# Personal working notes kept beside the code but never published.
*.local.md

# Last word wins in gitignore, so this negation must stay at the bottom.
# Both the scaffold and `vercel link` write a blanket `.env*` above, and either
# one silently swallows the template the README tells every reader to copy.
!.env.example
