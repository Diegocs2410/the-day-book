# Supabase — the publishable key is safe in the browser, the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic — used only by the availability parser. Server-side only, never NEXT_PUBLIC_.
# The app runs fine without it: the natural-language box degrades to the manual grid.
ANTHROPIC_API_KEY=

# Only needed for an *identity-linked* key — one created for "all workspaces".
# Those are rejected without it: "anthropic-workspace-id is required when
# authenticating with an identity-linked API key". A key scoped to a single
# workspace carries its own and needs nothing here, so leaving this empty is
# correct for most setups.
ANTHROPIC_WORKSPACE_ID=

# Demo accounts seeded by `npm run seed`, used by the one-click login buttons.
DEMO_SELLER_EMAIL=seller@demo.test
DEMO_BUYER_EMAIL=buyer@demo.test
DEMO_PASSWORD=showing-demo-2026
